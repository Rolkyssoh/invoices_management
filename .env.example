# Database Configuration
# The app uses SQLite and stores its database file in the OS app data directory
# (e.g. ~/.local/share/erp_invoices/erp_invoices.db on Linux).
# No database credentials are required.

# Development Configuration
DEV_URL=http://localhost:1420

# Application Configuration
APP_NAME=ERP Invoices
APP_VERSION=1.0.0

# Security (generate your own secret)
JWT_SECRET=your-secret-key-here
SESSION_TIMEOUT=3600

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Frontend Configuration
VITE_API_URL=http://localhost:1420
